# Copy to .env and adjust for local development.
FINOPS_ENVIRONMENT=development
FINOPS_DEFAULT_NORMALIZATION_STRATEGY=balanced
FINOPS_PRICING_PROVIDER=mock
# -- Multi-cloud (Phase 9) --
# "gcp" (default) | "aws" | "azure". Selects which cloud's catalog/pricing
# provider backs the estimation pipeline. AWS/Azure are mock-only this phase
# (no live Pricing/Retail Prices API integration yet - see docs/ROADMAP.md).
# CustomerRequirement/region/machine_family inputs are unchanged regardless
# of this setting - each provider maps the same canonical vocabulary onto
# its own real regions/instance families.
FINOPS_CLOUD_PROVIDER=gcp
FINOPS_DEFAULT_CURRENCY=USD
FINOPS_DEFAULT_TAX_RATE_PERCENT=0
FINOPS_SUPPORT_PLAN_PERCENT=0
FINOPS_LOG_LEVEL=INFO

# -- Uploads (Phase 10 security review) --
# Caps the size of Excel questionnaire uploads (POST /api/v1/intake/excel -
# which requires no authentication - and the per-project shortcut). 10 MB
# is generous for a questionnaire workbook.
FINOPS_MAX_UPLOAD_SIZE_BYTES=10485760

# -- Persistence (Phase 3) --
# SQLite file by default - zero setup. For Postgres (e.g. via docker-compose):
# FINOPS_DATABASE_URL=postgresql+psycopg2://finops:finops_dev_password@localhost:5432/finops
FINOPS_DATABASE_URL=sqlite:///./finops.db
# true = create tables automatically on startup (convenient for local dev).
# Set to false and run `alembic upgrade head` in any shared/production environment.
FINOPS_AUTO_CREATE_TABLES=true

# -- Auth (Phase 3) --
# REQUIRED: set this to a long random value in any non-local environment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FINOPS_JWT_SECRET_KEY=insecure-dev-secret-change-me
FINOPS_JWT_ALGORITHM=HS256
FINOPS_JWT_EXPIRE_MINUTES=1440

# -- Live GCP pricing (Phase 5) --
# Set FINOPS_PRICING_PROVIDER=gcp to switch from mock pricing to the real
# Cloud Billing Catalog API. Requires exactly one of the two credentials
# below (service account takes precedence if both are set):
#
# FINOPS_PRICING_PROVIDER=gcp
# FINOPS_GCP_SERVICE_ACCOUNT_JSON=/path/to/your-service-account-key.json
# FINOPS_GCP_API_KEY=your-cloud-billing-api-key
#
# The service account only needs the "Cloud Billing API" scope (no project
# IAM roles are required - the Catalog API serves public list pricing).
# FINOPS_GCP_BILLING_ACCOUNT_ID is not used by the Catalog API; reserved for
# future account-scoped features.
# FINOPS_GCP_BILLING_ACCOUNT_ID=012345-6789AB-CDEF01

# -- SKU cache (Phase 5) --
# Redis is used when reachable; falls back to an in-process cache
# automatically otherwise (see app/pricing/cache.py), so this is optional.
FINOPS_REDIS_URL=redis://localhost:6379/0
FINOPS_SKU_CACHE_TTL_SECONDS=86400

# -- Async jobs (Phase 7) --
# Celery broker/result backend both default to FINOPS_REDIS_URL above if
# left unset - only set these if you want to split job traffic onto a
# different Redis instance. Never set FINOPS_CELERY_TASK_ALWAYS_EAGER=true
# outside tests - it makes /api/v1/jobs/* block synchronously, defeating
# the point of a queue.
# FINOPS_CELERY_BROKER_URL=redis://localhost:6379/1
# FINOPS_CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -- Rate limiting (Phase 7) --
# Redis-backed when reachable, falls back to an in-process counter
# otherwise (see app/middleware/rate_limit.py).
FINOPS_RATE_LIMIT_ENABLED=true
FINOPS_RATE_LIMIT_REQUESTS_PER_MINUTE=120
FINOPS_RATE_LIMIT_HEAVY_REQUESTS_PER_MINUTE=20

# -- Request logging (Phase 7) --
FINOPS_REQUEST_LOGGING_ENABLED=true

# -- AI Assistant (Phase 11) --
# Backs the floating chat widget with a real Claude call. Leave unset to
# have the endpoint return 503 (the frontend falls back to a "not
# configured" message rather than pretending to be a live assistant).
# Get a key at https://console.anthropic.com/settings/keys
# FINOPS_ANTHROPIC_API_KEY=sk-ant-...
FINOPS_ASSISTANT_MODEL=claude-opus-5

# -- Secrets management (Phase 7) --
# Alternative to inline env vars - point this at a mounted secret file
# (the standard Docker/Kubernetes Secret pattern) instead of putting the
# raw value in FINOPS_JWT_SECRET_KEY.
# FINOPS_JWT_SECRET_KEY_FILE=/run/secrets/jwt_secret_key
#
# Starting with FINOPS_ENVIRONMENT=production now refuses to boot if the
# JWT secret is still the insecure default, CORS is wide open ("*"), or
# FINOPS_AUTO_CREATE_TABLES is left on - see app/core/secrets.py.
