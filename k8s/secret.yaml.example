# Template only - copy to secret.yaml, fill in real values, and NEVER
# commit the filled-in version (it's already gitignored - see
# docs/DEPLOYMENT.md). Every value below is base64 of a placeholder; replace
# with `echo -n '<real value>' | base64` output, or build the Secret
# imperatively instead (also shown in docs/DEPLOYMENT.md) so the real
# values never touch a file on disk at all.
#
# FINOPS_JWT_SECRET_KEY must be a real random 32+ char value in production -
# `validate_production_security()` (backend/app/core/secrets.py) refuses to
# boot otherwise. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
apiVersion: v1
kind: Secret
metadata:
  name: finops-secrets
  namespace: finops
type: Opaque
data:
  # echo -n 'insecure-placeholder-change-me-before-deploying-32chars' | base64
  FINOPS_JWT_SECRET_KEY: aW5zZWN1cmUtcGxhY2Vob2xkZXItY2hhbmdlLW1lLWJlZm9yZS1kZXBsb3lpbmctMzJjaGFycw==
  # echo -n 'finops_change_me' | base64
  POSTGRES_PASSWORD: Zmlub3BzX2NoYW5nZV9tZQ==
  # Full connection string incl. the password above - kept as one value so
  # the app just reads FINOPS_DATABASE_URL, same as every other environment
  # (local dev, docker-compose, tests_integration/).
  # echo -n 'postgresql+psycopg2://finops:finops_change_me@finops-postgres:5432/finops' | base64
  FINOPS_DATABASE_URL: cG9zdGdyZXNxbCtwc3ljb3BnMjovL2Zpbm9wczpmaW5vcHNfY2hhbmdlX21lQGZpbm9wcy1wb3N0Z3Jlczo1NDMyL2Zpbm9wcw==
  # Only needed if FINOPS_PRICING_PROVIDER=gcp in configmap.yaml (live GCP
  # pricing, Phase 5) - omit this key entirely to stay on mock pricing.
  # echo -n '{"type": "service_account", ...}' | base64
  FINOPS_GCP_SERVICE_ACCOUNT_JSON: e30=
